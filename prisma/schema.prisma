// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Model: User
// Pengguna/pengambil keputusan yang melakukan penilaian AHP
// ------------------------------------------------------------
model User {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  password      String               // Hashed password (jangan disimpan plaintext)
  role          Role                 @default(USER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relasi
  criteriaComparisons   CriteriaComparison[]
  supplierComparisons   SupplierComparison[]
  criteriaPriorities    CriteriaPriority[]
  supplierPriorities    SupplierPriority[]

  // Relasi NextAuth
  accounts            Account[]
  sessions            Session[]

  // Riwayat perhitungan
  calculationHistories CalculationHistory[]

  @@map("users")
}

// ------------------------------------------------------------
// Model: Account
// Akun OAuth / credentials — dibutuhkan oleh NextAuth PrismaAdapter
// ------------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ------------------------------------------------------------
// Model: Session
// Sesi database — dibutuhkan oleh NextAuth PrismaAdapter
// ------------------------------------------------------------
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ------------------------------------------------------------
// Model: VerificationToken
// Token verifikasi — dibutuhkan oleh NextAuth PrismaAdapter
// ------------------------------------------------------------
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  ADMIN
  USER
}

// ------------------------------------------------------------
// Model: Criteria
// Kriteria dan subkriteria dalam hierarki AHP (self-referential)
// ------------------------------------------------------------
model Criteria {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  level       Int       @default(0) // 0 = kriteria utama, 1 = subkriteria, dst.
  parentId    String?   @map("parent_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relasi hierarki
  parent      Criteria?  @relation("CriteriaHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Criteria[] @relation("CriteriaHierarchy")

  // Relasi perbandingan
  criteriaComparisons1 CriteriaComparison[] @relation("Criteria1")
  criteriaComparisons2 CriteriaComparison[] @relation("Criteria2")
  criteriaPriorities   CriteriaPriority[]
  supplierComparisons  SupplierComparison[]
  supplierPriorities   SupplierPriority[]

  @@unique([name, parentId]) // Nama unik dalam satu level/induk
  @@index([parentId])
  @@map("criteria")
}

// ------------------------------------------------------------
// Model: Supplier
// Alternatif pemasok bahan baku
// ------------------------------------------------------------
model Supplier {
  id             String   @id @default(cuid())
  name           String
  address        String?  @db.Text
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi perbandingan dan prioritas
  supplierComparisons1 SupplierComparison[] @relation("Supplier1")
  supplierComparisons2 SupplierComparison[] @relation("Supplier2")
  supplierPriorities   SupplierPriority[]

  @@map("suppliers")
}

// ------------------------------------------------------------
// Model: CriteriaComparison
// Perbandingan berpasangan antar kriteria (Saaty scale 1-9)
// Hanya menyimpan satu arah (criteria1Id < criteria2Id) untuk menghindari duplikasi
// ------------------------------------------------------------
model CriteriaComparison {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  criteria1Id  String   @map("criteria1_id")
  criteria2Id  String   @map("criteria2_id")
  value        Float    // Skala 1/9 hingga 9, disimpan sebagai desimal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relasi
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria1  Criteria @relation("Criteria1", fields: [criteria1Id], references: [id], onDelete: Cascade)
  criteria2  Criteria @relation("Criteria2", fields: [criteria2Id], references: [id], onDelete: Cascade)

  // Constraint: hanya satu perbandingan per pasangan kriteria per user
  @@unique([userId, criteria1Id, criteria2Id])
  @@index([userId])
  @@index([criteria1Id, criteria2Id])
  @@map("criteria_comparisons")
}

// ------------------------------------------------------------
// Model: SupplierComparison
// Perbandingan berpasangan antar pemasok untuk setiap kriteria
// Hanya menyimpan satu arah (supplier1Id < supplier2Id)
// ------------------------------------------------------------
model SupplierComparison {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  criteriaId   String   @map("criteria_id")
  supplier1Id  String   @map("supplier1_id")
  supplier2Id  String   @map("supplier2_id")
  value        Float    // Skala 1/9 hingga 9
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relasi
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria   Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  supplier1  Supplier @relation("Supplier1", fields: [supplier1Id], references: [id], onDelete: Cascade)
  supplier2  Supplier @relation("Supplier2", fields: [supplier2Id], references: [id], onDelete: Cascade)

  // Constraint: satu perbandingan per pasangan supplier dalam kriteria tertentu per user
  @@unique([userId, criteriaId, supplier1Id, supplier2Id])
  @@index([userId])
  @@index([criteriaId])
  @@map("supplier_comparisons")
}

// ------------------------------------------------------------
// Model: CriteriaPriority
// Bobot prioritas hasil perhitungan AHP untuk setiap kriteria per user
// Menyimpan nilai eigenvector dan Consistency Ratio (CR)
// ------------------------------------------------------------
model CriteriaPriority {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  criteriaId       String   @map("criteria_id")
  priority         Float    // Bobot prioritas (eigenvector)
  consistencyRatio Float?   @map("consistency_ratio") // CR hasil perhitungan (opsional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  // Satu bobot per kriteria per user
  @@unique([userId, criteriaId])
  @@index([userId])
  @@map("criteria_priorities")
}

// ------------------------------------------------------------
// Model: SupplierPriority
// Bobot prioritas pemasok untuk setiap kriteria per user
// Digunakan untuk menghitung total skor akhir alternatif
// ------------------------------------------------------------
model SupplierPriority {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  criteriaId       String   @map("criteria_id")
  supplierId       String   @map("supplier_id")
  priority         Float    // Bobot prioritas pemasok pada kriteria tertentu
  consistencyRatio Float?   @map("consistency_ratio") // CR hasil perhitungan (opsional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Satu bobot per supplier per kriteria per user
  @@unique([userId, criteriaId, supplierId])
  @@index([userId])
  @@index([criteriaId])
  @@map("supplier_priorities")
}

// ------------------------------------------------------------
// Model: CalculationHistory
// Riwayat hasil perhitungan AHP — menyimpan snapshot JSON dari
// seluruh hasil perhitungan untuk keperluan histori dan komparasi
// ------------------------------------------------------------
model CalculationHistory {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  label      String?  // Label opsional (misal "Perhitungan Q2 2026")
  data       Json     // Snapshot lengkap AHPResult (criteria, suppliers, ranking, warnings)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("calculation_histories")
}
